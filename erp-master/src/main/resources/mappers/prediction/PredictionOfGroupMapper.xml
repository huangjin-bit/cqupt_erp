        <result property="marketName" column="MARKETNAME"/>
        <result property="productName" column="PRODUCTNAME" />
        <result property="price" column="PRICE" />
        <result property="mount" column="MOUNT"/>
        <result property="predictionID" column="PREDICTIONID" />
    </resultMap>

    <select id="findAllPredictionOfGroup" resultMap="predictionOfGroup" parameterType="string">
        select GROUPNAME,PERIOD,MARKETNAME,PRODUCTNAME,PRICE,MOUNT,PREDICTIONID from predictionofgroup where GROUPNAME=#{groupName}
