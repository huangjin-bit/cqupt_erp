    <insert id="addPredictionOfGroups" parameterType="list" keyProperty="predictionID" keyColumn="PREDICTIONID" useGeneratedKeys="true">
        INSERT into predictionofgroup
        (GROUPNAME,PERIOD,MARKETNAME,PRODUCTNAME,PRICE,MOUNT)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (
            #{item.groupName},
            #{item.period},
            #{item.marketName},
            #{item.productName},
            #{item.price},
            #{item.mount}
            )
        </foreach>
    </insert>
    <resultMap id="predictionOfGroup"
