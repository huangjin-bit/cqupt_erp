<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cqupt.mislab.erpn.dao.product.UnDevelopProductDao">
    <delete id="deleteUnDevelopProduct">
        delete from undevelopproduct where userUnique=#{userUnique} and productName=#{productName}
    </delete>

    <select id="findUnDevelopProductsByUserUnique"
            resultType="com.cqupt.mislab.erpn.model.entity.product.UnDevelopProduct">
        select USERUNIQUE,PRODUCTNAME,RESEARCHPERIOD,RESEARCHCOST from undevelopproduct where userUnique=#{userUnique};
    </select>
    <select id="findUnDevelopProductByUserUnique"
            resultType="com.cqupt.mislab.erpn.model.entity.product.UnDevelopProduct">
        select USERUNIQUE,PRODUCTNAME,RESEARCHPERIOD,RESEARCHCOST from undevelopproduct where userUnique=#{userUnique} and productName=#{productName}
    </select>
</mapper>